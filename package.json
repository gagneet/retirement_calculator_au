{
  "name": "retirement-calculator",
  "version": "2.1.0",
  "description": "Australian Retirement Calculator",
  "private": true,
  "scripts": {
    "build": "webpack",
    "deploy": "bash deploy.sh",
    "test": "jest --testPathPatterns=tests/",
    "test:e2e": "playwright_modules/node_modules/.bin/playwright test",
    "test:e2e:ui": "playwright_modules/node_modules/.bin/playwright test --ui",
    "test:e2e:report": "playwright_modules/node_modules/.bin/playwright show-report",
    "test:load": "k6 run tests/load/k6-advanced-v2.js"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ],
    "moduleNameMapper": {
      "\\.(css|less|scss)$": "<rootDir>/tests/__mocks__/fileMock.js"
    }
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          }
        }
      ]
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "babel-jest": "^30.4.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "html-webpack-plugin": "^5.6.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "mini-css-extract-plugin": "^2.10.2",
    "terser-webpack-plugin": "^5.6.0",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2"
  }
}
