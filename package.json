{
  "name": "retirement-calculator",
  "version": "1.1.0",
  "description": "Australian Retirement Calculator",
  "private": true,
  "scripts": {
    "build": "webpack",
    "deploy": "bash deploy.sh",
    "test": "jest --testPathPatterns=tests/",
    "test:e2e": "playwright_modules/node_modules/.bin/playwright test",
    "test:e2e:ui": "playwright_modules/node_modules/.bin/playwright test --ui",
    "test:e2e:report": "playwright_modules/node_modules/.bin/playwright show-report"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ],
    "moduleNameMapper": {
      "\\.(css|less|scss)$": "<rootDir>/tests/__mocks__/fileMock.js"
    }
  },
  "babel": {
    "presets": [["@babel/preset-env", {"targets": {"node": "current"}}]]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "babel-jest": "^30.3.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "html-webpack-plugin": "^5.6.6",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "mini-css-extract-plugin": "^2.10.1",
    "terser-webpack-plugin": "^5.4.0",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.0"
  }
}
